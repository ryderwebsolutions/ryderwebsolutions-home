{
  "version": 2,
  "rewrites": [
    {
      "source": "/templates/arcscaffolding/assets/:path*",
      "destination": "/templates/arcscaffolding/dist/assets/:path*"
    },
    {
      "source": "/templates/arcscaffolding/images/:path*",
      "destination": "/templates/arcscaffolding/dist/images/:path*"
    },
    {
      "source": "/templates/arcscaffolding(.*)",
      "destination": "/templates/arcscaffolding/dist/index.html"
    },
    {
      "source": "/templates/interior/assets/:path*",
      "destination": "/templates/interior/dist/assets/:path*"
    },
    {
      "source": "/templates/interior/images/:path*",
      "destination": "/templates/interior/dist/images/:path*"
    },
    {
      "source": "/templates/interior(.*)",
      "destination": "/templates/interior/dist/index.html"
    }
  ]
}
