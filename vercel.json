{
  "version": 2,
  "routes": [
    {
      "src": "/templates/arcscaffolding/assets/(.*)",
      "dest": "/templates/arcscaffolding/dist/assets/$1"
    },
    {
      "src": "/templates/arcscaffolding/images/(.*)",
      "dest": "/templates/arcscaffolding/dist/images/$1"
    },
    {
      "src": "/templates/arcscaffolding/(.*)",
      "dest": "/templates/arcscaffolding/dist/index.html"
    },
    {
      "src": "/templates/interior/assets/(.*)",
      "dest": "/templates/interior/dist/assets/$1"
    },
    {
      "src": "/templates/interior/images/(.*)",
      "dest": "/templates/interior/dist/images/$1"
    },
    {
      "src": "/templates/interior/(.*)",
      "dest": "/templates/interior/dist/index.html"
    }
  ]
}
