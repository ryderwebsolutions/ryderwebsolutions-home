{
    "version": 2,
    "buildCommand": "npm run build:interior",
    "outputDirectory": "templates/interior/dist",
    "rewrites": [
        {
            "source": "/templates/interior/assets/:path*",
            "destination": "/assets/:path*"
        },
        {
            "source": "/templates/interior/:path*",
            "destination": "/index.html"
        },
        {
            "source": "/templates/interior",
            "destination": "/index.html"
        }
    ]
}
